{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null && $code.matches(/^[A-Z2-9]{6}$/)",
        ".write": "auth != null && $code.matches(/^[A-Z2-9]{6}$/) && newData.exists()",
        "state": { ".validate": "newData.exists()" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "ownerUid": { ".validate": "newData.isString()" },
        "$other": { ".validate": false }
      }
    }
  }
}
